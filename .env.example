# Industrial Fire Detection — Machine Learning Backend Environment Configuration
# Copy this file to .env and configure for local development.
# NEVER commit the real .env file or real secrets to version control.

# API Authentication Key (Required for POST /api/v1/predict)
# Supported environment variable names: ML_API_KEY (preferred) or API_KEY
ML_API_KEY=your_local_development_key_here

# Server Binding Configuration (Default localhost)
# Do NOT bind to 0.0.0.0 in development or expose publicly without authentication/TLS proxy.
API_HOST=127.0.0.1
API_PORT=8000
